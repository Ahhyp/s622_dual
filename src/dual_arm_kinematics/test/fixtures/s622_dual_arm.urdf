    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://s622_moveit_descriptions/meshes/wrist3_link.STL"/>
      </geometry>
    </collision>
  </link>
  <joint name="right_j6" type="revolute">
    <origin rpy="-1.5708 0 0" xyz="0 0 0.102"/>
    <parent link="right_wrist2_link"/>
    <child link="right_wrist3_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="28" lower="-3.0543" upper="3.0543" velocity="3.2"/>
    <calibration falling="0" rising="0"/>
    <dynamics damping="0" friction="0"/>
    <safety_controller k_position="15" k_velocity="10" soft_lower_limit="-3.0543" soft_upper_limit="3.0543"/>
  </joint>
  <link name="right_finger1">
    <inertial>
      <origin rpy="0 0 0" xyz="0.00067584 0.03547 -5.8981E-06"/>
      <mass value="0.008826"/>
      <inertia ixx="1.5494E-06" ixy="5.248E-07" ixz="3.4585E-09" iyy="9.8473E-07" iyz="-4.5799E-09" izz="1.9457E-06"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://s622_moveit_descriptions/meshes/finger1.STL"/>
      </geometry>
      <material name="">
        <color rgba="1 1 1 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://s622_moveit_descriptions/meshes/finger1.STL"/>
      </geometry>
    </collision>
  </link>
  <joint name="right_finger1_joint" type="prismatic">
    <origin rpy="1.5708 0 3.1416" xyz="-0.0099996 -8.7262E-05 0.1658"/>
    <parent link="right_wrist3_link"/>
    <child link="right_finger1"/>
    <axis xyz="0.99996 0 -0.0087267"/>
    <limit effort="150" lower="-1e-06" upper="0.0305" velocity="3.2"/>
  </joint>
  <link name="right_finger2">
    <inertial>
      <origin rpy="0 0 0" xyz="-0.00067584 0.03547 5.8981E-06"/>
      <mass value="0.008826"/>
      <inertia ixx="1.5494E-06" ixy="-5.248E-07" ixz="3.4585E-09" iyy="9.8473E-07" iyz="4.5799E-09" izz="1.9457E-06"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://s622_moveit_descriptions/meshes/finger2.STL"/>
      </geometry>
