  <joint name="right_finger2_joint" type="prismatic">
    <origin rpy="1.5708 0 3.1416" xyz="0.0099996 8.7271E-05 0.1658"/>
    <parent link="right_wrist3_link"/>
    <child link="right_finger2"/>
    <axis xyz="0.99996 0 -0.0087267"/>
    <limit effort="150" lower="-0.0305" upper="1e-06" velocity="3.2"/>
  </joint>
  <!-- Grasp frame at the center of the gripper.
             [2026-09-20] 补气爪本体质量（见上方 gripper_body_* 属性）。 -->
  <link name="right_grasp_frame">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 -0.0868"/>
      <mass value="0.135"/>
      <inertia ixx="6.700500000000001e-05" ixy="0" ixz="0" iyy="6.700500000000001e-05" iyz="0" izz="3.600000000000001e-05"/>
    </inertial>
  </link>
  <joint name="right_wrist3_to_grasp_frame" type="fixed">
    <parent link="right_wrist3_link"/>
    <child link="right_grasp_frame"/>
    <origin rpy="0 0 0" xyz="0 0 0.2168"/>
  </joint>
  <link name="right_calibration_marker"/>
  <link name="right_aruco_marker_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.04 0.04 0.002"/>
      </geometry>
      <material name="aruco_placeholder">
        <color rgba="1 1 1 1"/>
      </material>
    </visual>
  </link>
  <gazebo reference="right_aruco_marker_link">
    <visual>
      <material>
        <ambient>1 1 1 1</ambient>
        <diffuse>1 1 1 1</diffuse>
        <specular>0 0 0 1</specular>
        <emissive>1 1 1 1</emissive>
        <pbr>
          <metal>
            <albedo_map>model://aruco_marker_1/materials/textures/aruco_id1.png</albedo_map>
            <emissive_map>model://aruco_marker_1/materials/textures/aruco_id1.png</emissive_map>
            <metalness>0.0</metalness>
            <roughness>1.0</roughness>
          </metal>
        </pbr>
      </material>
    </visual>
  </gazebo>
  <joint name="right_wrist3_to_aruco_marker" type="fixed">
    <parent link="right_wrist3_link"/>
    <child link="right_aruco_marker_link"/>
    <origin rpy="-1.5708 0 0" xyz="0 -0.04 0.15"/>
  </joint>
  <joint name="right_wrist3_to_calibration_marker" type="fixed">
    <parent link="right_wrist3_link"/>
    <child link="right_calibration_marker"/>
    <origin rpy="0 0 0" xyz="4.8765E-05 -0.011601 0.1636"/>
  </joint>
  <joint name="right_mount_joint" type="fixed">
    <parent link="world"/>
    <child link="right_base_link"/>
    <origin rpy="0 0 0" xyz="-0.35 0 0"/>
  </joint>
  <!-- ============ Gripper 摩擦 (双臂各一份, 从 M2.1 前缀化) ============ -->
  <gazebo reference="left_finger1_joint">
    <mu1>500.0</mu1>
    <mu2>500.0</mu2>
    <kp>30000</kp>
    <kd>15</kd>
  </gazebo>
  <gazebo reference="left_finger2_joint">
    <mu1>500.0</mu1>
    <mu2>500.0</mu2>
    <kp>30000</kp>
    <kd>15</kd>
  </gazebo>
  <gazebo reference="right_finger1_joint">
    <mu1>500.0</mu1>
    <mu2>500.0</mu2>
    <kp>30000</kp>
    <kd>15</kd>
  </gazebo>
  <gazebo reference="right_finger2_joint">
    <mu1>500.0</mu1>
    <mu2>500.0</mu2>
    <kp>30000</kp>
    <kd>15</kd>
  </gazebo>
  <ros2_control name="left_GazeboSimSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <!-- 6 个关节全部前缀化,同时 initial_positions 用无前缀 key 索引 -->
    <joint name="left_j1">
      <command_interface name="velocity"/>
      <state_interface name="position">
        <param name="initial_value">0.5</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="left_j2">
      <command_interface name="velocity"/>
      <state_interface name="position">
        <param name="initial_value">-1.05</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="left_j3">
      <command_interface name="velocity"/>
      <state_interface name="position">
        <param name="initial_value">1.05</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="left_j4">
      <command_interface name="velocity"/>
      <state_interface name="position">
        <param name="initial_value">-1.05</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="left_j5">
      <command_interface name="velocity"/>
      <state_interface name="position">
        <param name="initial_value">-0.8</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="left_j6">
      <command_interface name="velocity"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="left_finger1_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0</param>
      </state_interface>
      <!-- 2026-08-26：补 velocity state interface（对齐手臂关节）。
                     缺失时 JSB 发布 finger velocity=NaN，且 gz_ros2_control read()
                     无判空读 JointVelocity 组件 → write() POSITION 分支 target_vel=NaN
                     → gazebo [Err] Invalid joint velocity value [nan] commanded -->
      <state_interface name="velocity"/>
    </joint>
    <joint name="left_finger2_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>
  <ros2_control name="right_GazeboSimSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <!-- 6 个关节全部前缀化,同时 initial_positions 用无前缀 key 索引 -->
    <joint name="right_j1">
      <command_interface name="velocity"/>
      <state_interface name="position">
        <param name="initial_value">0.5</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="right_j2">
      <command_interface name="velocity"/>
      <state_interface name="position">
        <param name="initial_value">-1.05</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="right_j3">
      <command_interface name="velocity"/>
      <state_interface name="position">
        <param name="initial_value">1.05</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="right_j4">
      <command_interface name="velocity"/>
      <state_interface name="position">
        <param name="initial_value">-1.05</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="right_j5">
      <command_interface name="velocity"/>
      <state_interface name="position">
        <param name="initial_value">-0.8</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="right_j6">
      <command_interface name="velocity"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="right_finger1_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0</param>
      </state_interface>
      <!-- 2026-08-26：补 velocity state interface（对齐手臂关节）。
                     缺失时 JSB 发布 finger velocity=NaN，且 gz_ros2_control read()
                     无判空读 JointVelocity 组件 → write() POSITION 分支 target_vel=NaN
                     → gazebo [Err] Invalid joint velocity value [nan] commanded -->
      <state_interface name="velocity"/>
    </joint>
    <joint name="right_finger2_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>
  <material name="aluminum">
    <color rgba="0.5 0.5 0.5 1"/>
  </material>
  <material name="plastic">
    <color rgba="0.1 0.1 0.1 1"/>
  </material>
  <!-- camera body, with origin at bottom screw mount -->
  <joint name="wrist_camera_joint" type="fixed">
    <origin rpy="0 -1.57079632679 -1.57079632679" xyz="0 -0.05 -0.09"/>
    <parent link="right_grasp_frame"/>
    <child link="wrist_camera_bottom_screw_frame"/>
  </joint>
  <link name="wrist_camera_bottom_screw_frame"/>
  <joint name="wrist_camera_link_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0.010600000000000002 0.0175 0.0125"/>
    <parent link="wrist_camera_bottom_screw_frame"/>
    <child link="wrist_camera_link"/>
  </joint>
  <link name="wrist_camera_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 -0.0175 0"/>
      <geometry>
        <box size="0.02505 0.09 0.025"/>
      </geometry>
      <material name="aluminum"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 -0.0175 0"/>
      <geometry>
        <box size="0.02505 0.09 0.025"/>
      </geometry>
    </collision>
    <inertial>
      <!-- The following are not reliable values, and should not be used for modeling -->
      <mass value="0.072"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.003881243" ixy="0.0" ixz="0.0" iyy="0.000498940" iyz="0.0" izz="0.003879257"/>
    </inertial>
  </link>
  <!-- camera depth joints and links -->
  <joint name="wrist_camera_depth_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <parent link="wrist_camera_link"/>
    <child link="wrist_camera_depth_frame"/>
  </joint>
  <link name="wrist_camera_depth_frame"/>
  <joint name="wrist_camera_depth_optical_joint" type="fixed">
    <origin rpy="-1.5707963267948966 0 -1.5707963267948966" xyz="0 0 0"/>
    <parent link="wrist_camera_depth_frame"/>
    <child link="wrist_camera_depth_optical_frame"/>
  </joint>
  <link name="wrist_camera_depth_optical_frame"/>
  <!-- camera left IR joints and links -->
  <joint name="wrist_camera_infra1_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0.0 0"/>
    <parent link="wrist_camera_link"/>
    <child link="wrist_camera_infra1_frame"/>
  </joint>
  <link name="wrist_camera_infra1_frame"/>
  <joint name="wrist_camera_infra1_optical_joint" type="fixed">
    <origin rpy="-1.5707963267948966 0 -1.5707963267948966" xyz="0 0 0"/>
    <parent link="wrist_camera_infra1_frame"/>
    <child link="wrist_camera_infra1_optical_frame"/>
  </joint>
  <link name="wrist_camera_infra1_optical_frame"/>
  <!-- camera right IR joints and links -->
  <joint name="wrist_camera_infra2_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 -0.05 0"/>
    <parent link="wrist_camera_link"/>
    <child link="wrist_camera_infra2_frame"/>
  </joint>
  <link name="wrist_camera_infra2_frame"/>
  <joint name="wrist_camera_infra2_optical_joint" type="fixed">
    <origin rpy="-1.5707963267948966 0 -1.5707963267948966" xyz="0 0 0"/>
    <parent link="wrist_camera_infra2_frame"/>
    <child link="wrist_camera_infra2_optical_frame"/>
  </joint>
  <link name="wrist_camera_infra2_optical_frame"/>
  <!-- camera color joints and links -->
  <joint name="wrist_camera_color_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0.015 0"/>
    <parent link="wrist_camera_link"/>
    <child link="wrist_camera_color_frame"/>
  </joint>
  <link name="wrist_camera_color_frame"/>
  <joint name="wrist_camera_color_optical_joint" type="fixed">
    <origin rpy="-1.5707963267948966 0 -1.5707963267948966" xyz="0 0 0"/>
    <parent link="wrist_camera_color_frame"/>
    <child link="wrist_camera_color_optical_frame"/>
  </joint>
  <link name="wrist_camera_color_optical_frame"/>
  <!-- [M2 标定] enable_depth=false 只渲染 RGB（标定只用 RGB，关 depth 渲染减半 → 帧率提升） -->
  <!-- ===== RGB Sensor ===== -->
  <gazebo reference="wrist_camera_color_frame">
    <sensor name="wrist_camera_rgb" type="camera">
      <topic>wrist_camera/image</topic>
      <update_rate>20</update_rate>
      <gz_frame_id>wrist_camera_color_optical_frame</gz_frame_id>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <camera>
        <horizontal_fov>1.4381513036433278</horizontal_fov>
        <image>
          <width>960</width>
          <height>540</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>10</far>
        </clip>
        <lens>
          <intrinsics>
            <fx>548.2995829398502</fx>
            <fy>547.5058385370907</fy>
            <cx>480.0</cx>
            <cy>270.0</cy>
            <s>0</s>
          </intrinsics>
          <projection>
            <p_fx>548.2995829398502</p_fx>
            <p_fy>547.5058385370907</p_fy>
            <p_cx>480.0</p_cx>
            <p_cy>270.0</p_cy>
            <tx>0</tx>
            <ty>0</ty>
          </projection>
        </lens>
        <optical_frame_id>wrist_camera_color_optical_frame</optical_frame_id>
      </camera>
    </sensor>
  </gazebo>
  <!-- camera_link 材质 -->
  <gazebo reference="wrist_camera_link">
    <material>Gazebo/Grey</material>
  </gazebo>
</robot>
