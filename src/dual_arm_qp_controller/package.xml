<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd"
            schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>dual_arm_qp_controller</name>
  <version>0.1.0</version>
  <description>
    ros2_control ControllerInterface for the dual-arm QP (C2.2 layer 3).
    Claims 12 position command interfaces (arms only) + 12 position state
    interfaces, runs the velocity-level QP at the controller_manager rate,
    integrates to position commands, and implements the D7 stream-health
    interlock (any single-arm stall -> both arms hold).
  </description>

  <maintainer email="1056651817@qq.com">Ahhyp</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>controller_interface</depend>
  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>eigen</depend>
  <depend>dual_arm_kinematics</depend>
  <depend>dual_arm_qp_core</depend>
  <depend>dual_arm_collision</depend>

  <exec_depend>s622_moveit_descriptions</exec_depend>
  <exec_depend>controller_manager</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
