# C4.3 S4 W1: latch a frozen object trajectory and start cooperative transport.
#
# The trajectory is passed inline so that a test / a higher-level executor does
# not have to stage a YAML file.  Every array is optional: an empty array means
# "use the documented default", and the reply says whether the spec was legal.
#
# Phase i moves the object by (phase_dx[i], phase_dy[i], phase_dz[i]) over
# phase_duration[i] seconds, using the controller's `time_scaling`.
string[]  phase_name
float64[] phase_duration          # s, must be > 0
float64[] phase_dx                # m
float64[] phase_dy                # m
float64[] phase_dz                # m
# Start object pose, row-major 3x4: [r11 r12 r13 px r21 ... pz] (12 values).
# Empty => T_hat_{O,L}(q) at the joint state when the request is served.
float64[] start_world_t_object
# Yaw (deg, about world z) at each phase boundary: size 1 or phases+1.
# Empty => [0].  Per-phase smoothstep keeps yaw rate zero at boundaries.
float64[] yaw_sweep_deg
float64  dt                       # s; 0 => the controller's dt
string   time_scaling             # "" => "smoothstep"; also "linear"
---
bool   accepted
string message
