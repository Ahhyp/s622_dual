<root BTCPP_format="4">
    <BehaviorTree ID="DescendTestTree">
        <Sequence>
            <MoveToPose named_pose="home"
                velocity_scale="0.2" acceleration_scale="0.2"
                ensure_servo_stopped="true"
                timeout_sec="20.0" />

            <PrintMessage msg="--- Descend 5cm ---" />
            <VisualAlign mode="descend"
                distance="0.05" speed="0.03"
                ensure_servo_started="true"
                timeout_sec="15.0" />

            <PrintMessage msg="--- Lift 5cm ---" />
            <VisualAlign mode="lift"
                distance="0.05" speed="0.03"
                ensure_servo_started="false"
                timeout_sec="15.0" />

            <PrintMessage msg="--- Retreat 3cm ---" />
            <VisualAlign mode="retreat"
                distance="0.03" speed="0.03"
                ensure_servo_started="false"
                timeout_sec="15.0" />

            <PrintMessage msg="Descend test SUCCESS" />
        </Sequence>
    </BehaviorTree>
</root>