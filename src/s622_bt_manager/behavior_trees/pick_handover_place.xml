<root BTCPP_format="4">

  <!-- ==========================================================================
       M4 主树：长条物体 Pick → 松耦合交接 → （可选）Place
       规划 §9 正式运动顺序：

         Left Pick → Attach Long Object → Left Lift
         → [HandoverRodOnly 子树]
             GenerateHandoverCandidate → Right Open → Right Pre-Pose
             → Right Low-Speed Approach → Right Close → VerifyRightGrasp
             → TransferObject → Left Open → Left Retreat → Right Retreat
         → （物体已在右手，后续 Place 由 M5/M6 处理）

       与旧版（cube + DualMove(dual_handover_ready)）的关键差别：
         1. 物体是长条（0.03×0.15×0.03），Attach/Transfer 用完整 position+orientation；
         2. 删除 "双爪同时夹 + DualMove 到固定交接位" 的老流程，改为
            Left 静止持物 → 运行期生成 Object-relative Receive Pose → 受控接近；
         3. Transfer 后先 Left Retreat 再 Right 动作（规划 §11）。
       旧 cube 版本保留在 pick_handover_place_cube.xml。
       ========================================================================== -->
  <BehaviorTree ID="PickHandoverPlace">
    <Fallback name="MainWithRecovery">

      <!-- ==================== 主任务 ==================== -->
      <Sequence name="MainTask">
        <CheckSystemReady />

        <!-- 起点：双臂 home -->
        <DualMoveToJointState named_pose="dual_home"
            velocity_scale="0.3" acceleration_scale="0.3"
            timeout_sec="20.0" />

        <!-- ============ 左臂 Pick ============
             [T6 结构版 2026-09-15] 用 YAML 标定的长条世界位姿算 pregrasp/descend，
             把整条 Pick→Handover 链路放进行为树（不依赖视觉）。
             视觉版（M1.7 链）保留在 git 历史与本文件下方注释里：
               DetectObject → GenerateGraspCandidate → LockTargetPixel → MoveToPose(pregrasp)
               → VisualAlign(xy) → VisualAlign(yaw) → AlignLockCheck → VisualAlign(descend)
             ================================================================== -->
        <SetGripper arm_prefix="left" command="open" timeout_sec="8.0" />

        <GenerateLeftGraspCandidate
            world_frame="world" output_frame="left_base_link"
            object_pos_world="{left_pick_object_world}"
            pregrasp_height="{left_pregrasp_height}"
            pregrasp_quat="{left_pregrasp_quat}"
            descend_distance="{left_descend_distance}"
            object_pose_in_left_grasp="{left_object_pos_v}"
            object_quat_in_left_grasp="{left_object_quat_v}"
            pregrasp_pose="{pregrasp_pose}"
            descend_distance_out="{descend_d}"
            object_pose_in_left_grasp_pose="{obj_in_left}" />

        <MoveToPose arm_prefix="left" target_pose="{pregrasp_pose}"
            velocity_scale="0.35" acceleration_scale="0.35"
            ensure_servo_stopped="true"
            timeout_sec="40.0" />

        <VisualAlign arm_prefix="left" mode="descend"
            distance="{descend_d}"
            speed="0.07"
            ensure_servo_started="true"
            timeout_sec="40.0" />

        <SetGripper arm_prefix="left" command="close"
            timeout_sec="10.0" finger_position="{finger_pos}" />
        <Wait sec="10.0" />
        <VerifyGrasp arm_prefix="left"
            finger_min_position="{right_finger_min_position}"
            gap_min="{left_finger_gap_min}" gap_max="{left_finger_gap_max}"
            settle_tol="{verify_settle_tol}" min_wait_sec="{verify_min_wait}"
            timeout_sec="60.0" finger_position="{finger_pos}" finger_gap="{left_gap}" />

        <!-- 长条 Attach：完整 position + orientation；PRE 阶段用 margin 盒 -->
        <AttachObject arm_prefix="left" object_name="{object_name}"
            size_x="{object_size_margin_x}" size_y="{object_size_margin_y}"
            size_z="{object_size_margin_z}"
            pose_in_link_full="{obj_in_left}"
            touch_links="{object_touch_links}" />

        <!-- 抬升必须 ompl 关节空间（servo lift 会掉杆，M4_2 §9.1）：
             用 PlanToJoints 到 YAML 里标定的 hold 关节角 -->
        <PlanToJoints arm_prefix="left"
            joint_positions="{left_hold_joints}"
            velocity_scale="0.30" planning_time="{plan_time}"
            timeout_sec="150.0" log_tag="L rise" />

        <!-- ============ 交接：整段收敛到 HandoverRodOnly 子树（规划 §9/§10/§11）============ -->
        <!-- _autoremap="true"：BT.CPP 的 SubTree **有自己的 blackboard**，
             不 autoremap 的话子树里 {object_name}/{receive_offset}/... 全部解析成空串
             （实测 T6 首跑：object_name='' → 场景查不到物体 + receive_offset 为 0 个元素 → 节点失败）。
             autoremap 让子树的未设端口自动回退到父 blackboard ✓ -->
        <SubTree ID="HandoverRodOnly" _autoremap="true" />

        <!-- ============ 收尾：物体已在右手（owner=RIGHT）============ -->
        <PrintMessage msg="=== M4 PickHandoverPlace: bar transferred to RIGHT ===" />
        <!-- Place 阶段属于 M5/M6，本树到此结束（物体 attached to right_grasp_frame） -->
      </Sequence>

      <!-- ============ Recovery（ownership-aware，规划 §12）============ -->
      <Sequence name="Recovery">
        <PrintMessage msg="=== M4 PickHandoverPlace RECOVERY ===" />
        <ForceSuccess>
          <StopServo arm_prefix="left" />
        </ForceSuccess>
        <ForceSuccess>
          <StopServo arm_prefix="right" />
        </ForceSuccess>
        <ForceSuccess>
          <SetGripper arm_prefix="right" command="open" timeout_sec="5.0" />
        </ForceSuccess>
        <ForceSuccess>
          <DualMoveToJointState named_pose="dual_home"
              velocity_scale="0.2" acceleration_scale="0.2"
              timeout_sec="25.0" />
        </ForceSuccess>
        <PrintMessage msg="=== M4 PickHandoverPlace RECOVERY DONE ===" />
        <AlwaysFailure />
      </Sequence>

    </Fallback>
  </BehaviorTree>

</root>
