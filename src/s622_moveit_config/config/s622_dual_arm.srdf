<?xml version="1.0" encoding="UTF-8"?>
<robot name="s622_dual_arm">

    <!-- ==================== Left Arm ==================== -->
    <group name="left_arm">
        <joint name="left_j1" />
        <joint name="left_j2" />
        <joint name="left_j3" />
        <joint name="left_j4" />
        <joint name="left_j5" />
        <joint name="left_j6" />
        <chain base_link="left_base_link" tip_link="left_grasp_frame" />
    </group>

    <group name="left_hand">
        <joint name="left_finger1_joint" />
        <joint name="left_finger2_joint" />
    </group>

    <group_state name="home" group="left_arm">
        <joint name="left_j1" value="0" />
        <joint name="left_j2" value="-1.5708" />
        <joint name="left_j3" value="0" />
        <joint name="left_j4" value="0" />
        <joint name="left_j5" value="0" />
        <joint name="left_j6" value="0" />
    </group_state>

    <group_state name="open_max" group="left_hand">
        <joint name="left_finger1_joint" value="0.0305" />
        <joint name="left_finger2_joint" value="-0.0305" />
    </group_state>
    <group_state name="close" group="left_hand">
        <joint name="left_finger1_joint" value="0" />
        <joint name="left_finger2_joint" value="0" />
    </group_state>

    <end_effector name="left_TCP" parent_link="left_grasp_frame"
        group="left_hand" parent_group="left_arm" />

    <!-- Left arm 内部 disable_collisions (M1.7 SRDF 前缀化) -->
    <disable_collisions link1="left_base_link" link2="left_shoulder_link" reason="Adjacent" />
    <disable_collisions link1="left_base_link" link2="left_upperarm_link" reason="Never" />
    <disable_collisions link1="left_finger1" link2="left_finger2" reason="Default" />
    <disable_collisions link1="left_finger1" link2="left_wrist1_link" reason="Never" />
    <disable_collisions link1="left_finger1" link2="left_wrist2_link" reason="Never" />
    <disable_collisions link1="left_finger1" link2="left_wrist3_link" reason="Adjacent" />
    <disable_collisions link1="left_finger2" link2="left_wrist1_link" reason="Never" />
    <disable_collisions link1="left_finger2" link2="left_wrist2_link" reason="Never" />
    <disable_collisions link1="left_finger2" link2="left_wrist3_link" reason="Adjacent" />
    <disable_collisions link1="left_forearm_link" link2="left_upperarm_link" reason="Adjacent" />
    <disable_collisions link1="left_forearm_link" link2="left_wrist1_link" reason="Adjacent" />
    <disable_collisions link1="left_shoulder_link" link2="left_upperarm_link" reason="Adjacent" />
    <disable_collisions link1="left_shoulder_link" link2="left_wrist1_link" reason="Never" />
    <disable_collisions link1="left_wrist1_link" link2="left_wrist2_link" reason="Adjacent" />
    <disable_collisions link1="left_wrist1_link" link2="left_wrist3_link" reason="Never" />
    <disable_collisions link1="left_wrist2_link" link2="left_wrist3_link" reason="Adjacent" />

    <!-- ==================== Right Arm ==================== -->
    <group name="right_arm">
        <joint name="right_j1" />
        <joint name="right_j2" />
        <joint name="right_j3" />
        <joint name="right_j4" />
        <joint name="right_j5" />
        <joint name="right_j6" />
        <chain base_link="right_base_link" tip_link="right_grasp_frame" />
    </group>

    <group name="right_hand">
        <joint name="right_finger1_joint" />
        <joint name="right_finger2_joint" />
    </group>

    <group_state name="home" group="right_arm">
        <joint name="right_j1" value="0" />
        <joint name="right_j2" value="-1.5708" />
        <joint name="right_j3" value="0" />
        <joint name="right_j4" value="0" />
        <joint name="right_j5" value="0" />
        <joint name="right_j6" value="0" />
    </group_state>

    <group_state name="open_max" group="right_hand">
        <joint name="right_finger1_joint" value="0.0305" />
        <joint name="right_finger2_joint" value="-0.0305" />
    </group_state>
    <group_state name="close" group="right_hand">
        <joint name="right_finger1_joint" value="0" />
        <joint name="right_finger2_joint" value="0" />
    </group_state>

    <end_effector name="right_TCP" parent_link="right_grasp_frame"
        group="right_hand" parent_group="right_arm" />

    <!-- Right arm 内部 disable_collisions -->
    <disable_collisions link1="right_base_link" link2="right_shoulder_link" reason="Adjacent" />
    <disable_collisions link1="right_base_link" link2="right_upperarm_link" reason="Never" />
    <disable_collisions link1="right_finger1" link2="right_finger2" reason="Default" />
    <disable_collisions link1="right_finger1" link2="right_wrist1_link" reason="Never" />
    <disable_collisions link1="right_finger1" link2="right_wrist2_link" reason="Never" />
    <disable_collisions link1="right_finger1" link2="right_wrist3_link" reason="Adjacent" />
    <disable_collisions link1="right_finger2" link2="right_wrist1_link" reason="Never" />
    <disable_collisions link1="right_finger2" link2="right_wrist2_link" reason="Never" />
    <disable_collisions link1="right_finger2" link2="right_wrist3_link" reason="Adjacent" />
    <disable_collisions link1="right_forearm_link" link2="right_upperarm_link" reason="Adjacent" />
    <disable_collisions link1="right_forearm_link" link2="right_wrist1_link" reason="Adjacent" />
    <disable_collisions link1="right_shoulder_link" link2="right_upperarm_link" reason="Adjacent" />
    <disable_collisions link1="right_shoulder_link" link2="right_wrist1_link" reason="Never" />
    <disable_collisions link1="right_wrist1_link" link2="right_wrist2_link" reason="Adjacent" />
    <disable_collisions link1="right_wrist1_link" link2="right_wrist3_link" reason="Never" />
    <disable_collisions link1="right_wrist2_link" link2="right_wrist3_link" reason="Adjacent" />

    <!-- ==================== Dual Arm 复合 group (方案 D) ==================== -->
    <group name="dual_arm">
        <group name="left_arm" />
        <group name="right_arm" />
    </group>

    <group_state name="dual_home" group="dual_arm">
        <joint name="left_j1" value="0" />
        <joint name="left_j2" value="-1.5708" />
        <joint name="left_j3" value="0" />
        <joint name="left_j4" value="0" />
        <joint name="left_j5" value="0" />
        <joint name="left_j6" value="0" />
        <joint name="right_j1" value="0" />
        <joint name="right_j2" value="-1.5708" />
        <joint name="right_j3" value="0" />
        <joint name="right_j4" value="0" />
        <joint name="right_j5" value="0" />
        <joint name="right_j6" value="0" />
    </group_state>

    <group_state name="dual_handover_ready" group="dual_arm">
        <joint name="left_j1" value="-0.5963" />
        <joint name="left_j2" value="-1.6969" />
        <joint name="left_j3" value="-2.2265" />
        <joint name="left_j4" value="0.7825" />
        <joint name="left_j5" value="2.1677" />
        <joint name="left_j6" value="1.5715" />
        <joint name="right_j1" value="-2.5432" />
        <joint name="right_j2" value="-1.4419" />
        <joint name="right_j3" value="2.2229" />
        <joint name="right_j4" value="-3.9223" />
        <joint name="right_j5" value="-2.1697" />
        <joint name="right_j6" value="1.5713" />
    </group_state>

</robot>