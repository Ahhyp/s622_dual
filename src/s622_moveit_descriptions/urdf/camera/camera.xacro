<?xml version="1.0"?>
<robot name="delirobo" xmlns:xacro="http://ros.org/wiki/xacro">
  <!-- =========================1) RealSense D435 的 URDF 结构========================= -->
  <xacro:include filename="$(find realsense2_description)/urdf/_d435.urdf.xacro" />

  <!-- =========================2) 分离 RGB + Depth sensor (规避 rgbd_camera 的 hfov/lens bug) ========================= -->
  <xacro:include filename="$(find s622_moveit_descriptions)/urdf/camera/rgbd_split.gazebo.xacro" />

  <!-- ============================宏 1：相机本体 (URDF frames + mesh) ============================ -->
  <!-- use_camera_visual: true=真实 mesh(d435.dae)，false=简化几何体(渲染快，RViz 不卡)。
       camera_link 本身必须保留（TF 树需要），只是 visual 形状不同。 -->
  <xacro:macro name="camera_v0" params="parent use_camera_visual:=true *joint_origin">
    <xacro:sensor_d435
      parent="${parent}"
      name="camera"
      use_nominal_extrinsics="true"
      add_plug="false"
      use_mesh="${use_camera_visual}">
      <xacro:insert_block name="joint_origin" />
    </xacro:sensor_d435>
  </xacro:macro>

  <!-- ============================宏 2：Gazebo 传感器 (分离 RGB + Depth) ============================ -->
  <!-- 仿真性能：fps 60→20、960×540→640×480（对齐 robotarm），渲染负载降 ~7 倍 → RTF 大幅提升。
       视觉伺服 50-100Hz 控制用锁定目标，20fps 检测足够。分辨率变化后 camera_info 自动更新，
       visual_servo 的 use_adaptive_jacobian=true 运行时自适应，j_img_to_base 仅作 fallback。 -->
  <xacro:macro name="camera_gazebo_v0">
    <xacro:gazebo_rgbd_split
      name="camera"
      fps="20"
      gz_topic_name="camera"
      image_width="640"
      image_height="480"
      h_fov="${82.4 * pi/180}"
      v_fov="${52.5 * pi/180}"
      min_depth="0.05"
      max_depth="10.0"/>

    <!-- camera_link 材质 -->
    <gazebo reference="camera_link">
      <material>Gazebo/Grey</material>
    </gazebo>
  </xacro:macro>
</robot>
