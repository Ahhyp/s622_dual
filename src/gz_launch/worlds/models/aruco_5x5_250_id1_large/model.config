<model>
  <name>aruco_5x5_250_id1_large</name>
  <version>1.0</version>
  <sdf version="1.7">model.sdf</sdf>
  <author><name>Fairino Arm</name></author>
  <description>
    Large DICT_5X5_250 ArUco marker (id=1) for M2.7 global eye-on-base
    calibration. Marker square 0.13 m inside a 0.16 m white board (vs the
    0.07 m wrist marker) so the marker stays >= 90 px at ~0.7-1.0 m range.
  </description>
</model>