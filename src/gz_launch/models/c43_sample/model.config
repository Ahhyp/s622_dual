<?xml version="1.0"?>
<!--
  c43_sample —— C4.3 S4 标准样件（W5-A）

  冻结来源（只读核对，未改动）：
    src/dual_arm_transport/config/transport_baseline.yaml
      schema: c43_s2_transport_baseline/v1
      object.size_xyz = [0.120000000, 0.050000000, 0.050000000]
      object.mass     = 0.350000000
      object.world_T_object = 平移 (0, 0, 0.275000000)

  S2 冻结基线**未给出**惯量，故惯量取「均匀密度长方体」由冻结尺寸与质量导出：
    Ixx = m/12 * (b^2 + c^2) = 0.35/12 * (0.05^2 + 0.05^2) = 1.458333e-04
    Iyy = m/12 * (a^2 + c^2) = 0.35/12 * (0.12^2 + 0.05^2) = 4.929167e-04
    Izz = m/12 * (a^2 + b^2) = 0.35/12 * (0.12^2 + 0.05^2) = 4.929167e-04
  这是建模选择，不是新增冻结数值；若 S2 后续给出批准惯量，以 S2 为准。

  模型坐标系：原点在几何中心（长方体中心）。世界布局由引用方给出，
  名义 `world_T_object` 的 z = 0.275 由 world 侧放置，不写死在本模型内。
-->
<model>
  <name>c43_sample</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>

  <author>
    <name>S622 C4.3 S4</name>
    <email>n/a</email>
  </author>

  <description>
    C4.3 S4 standard transport sample: 0.12 x 0.05 x 0.05 m box, 0.35 kg
    (frozen by S2 transport_baseline.yaml), dynamic rigid body.
  </description>
</model>
