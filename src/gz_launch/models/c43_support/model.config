<?xml version="1.0"?>
<!--
  c43_support —— C4.3 S4 圆柱支撑（W5-A）

  冻结来源（只读核对，未改动）：
    src/dual_arm_transport/config/transport_baseline.yaml
      support.id       = "c43_support"
      support.shape    = "cylinder"
      support.radius_m = 0.040000000
      support.height_m = 0.250000000
      support.top_z_m  = 0.250000000
      object.world_T_object = 平移 (0, 0, 0.275)  ⇒ 样件中心在支撑顶面上 0.025 m

  模型坐标系：**原点在支撑底面中心**（与 S2 的 z 约定一致）。
  圆柱几何中心在模型内抬高 +0.125 m，因此以 `<pose>0 0 0</pose>` 引用到 world 即
  自动满足「底面 z=0、顶面 z=0.25」，不需要引用方再算 0.125 的偏移。
  冻结尺寸未做任何改写；世界放置仍由引用方决定（W5-B 的 `c43_s4_world.sdf`）。

  支撑是夹具/台架，按静态刚体建模（不参与重力自由落体），
  避免用「动态支撑」+ 人为约束来掩盖稳定性问题。
-->
<model>
  <name>c43_support</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>

  <author>
    <name>S622 C4.3 S4</name>
    <email>n/a</email>
  </author>

  <description>
    C4.3 S4 cylindrical support: r = 0.04 m, h = 0.25 m, top face at z = 0.25 m
    (frozen by S2 transport_baseline.yaml). Model frame = support base centre.
  </description>
</model>
