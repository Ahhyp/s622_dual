<?xml version="1.0"?>
<!--
  c43_support model.sdf —— C4.3 S4 圆柱支撑（W5-A）

  冻结几何（S2 transport_baseline.yaml）：
    radius = 0.04 m, height = 0.25 m, top_z = 0.25 m
  模型坐标系：原点 = 支撑底面中心 ⇒ link 抬到 z=0.125（几何中心）。
  静态刚体（夹具/台架），尺寸不可为了适配 world 或旧场景而改动。
-->
<sdf version="1.9">
  <model name="c43_support">
    <pose>0 0 0 0 0 0</pose>
    <self_collide>false</self_collide>
    <static>true</static>

    <!-- 底面中心为模型原点：圆柱几何中心 = +0.125 m -->
    <link name="base_link">
      <pose>0 0 0.125 0 0 0</pose>

      <!-- 静态夹具：不设 <inertial>。Gazebo 对 static link 不使用质量/惯量，
           与其编造一组未冻结的质量数值，不如明确保持「无惯量」语义。 -->

      <collision name="collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.04</radius>
            <length>0.25</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

      <visual name="visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.04</radius>
            <length>0.25</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.30 0.32 0.36 1</ambient>
          <diffuse>0.36 0.38 0.42 1</diffuse>
          <specular>0.15 0.15 0.15 1</specular>
          <emissive>0 0 0 1</emissive>
        </material>
      </visual>
    </link>
  </model>
</sdf>
