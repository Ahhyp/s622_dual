<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="s622_dual_arm">

    <xacro:property name="M_PI" value="3.14159265358979323846" />

    <xacro:arg name="instantiate" default="false" />   <!-- ← 加这行 -->
    <!-- 2026-08-25 对齐单臂/robotarm：include_camera_visual=false（默认）=
         简化几何体，RViz 不卡；true=真实 mesh（d435.dae） -->
    <xacro:arg name="include_camera_visual" default="false" />

    <!-- ============ world 根 link ============ -->
    <link name="world" />

    <!-- ============ Gazebo 全局插件 ============ -->
    <gazebo>
        <plugin filename="gz_ros2_control-system"
            name="gz_ros2_control::GazeboSimROS2ControlPlugin">
            <parameters>$(find s622_moveit_config)/config/dual_arm_controllers.yaml</parameters>
        </plugin>

        <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher" />

        <plugin filename="gz-sim-pose-publisher-system"
            name="gz::sim::systems::PosePublisher">
            <publish_link_pose>true</publish_link_pose>
            <use_pose_vector_msg>true</use_pose_vector_msg>
            <publish_nested_model_pose>true</publish_nested_model_pose>
        </plugin>

        <plugin filename="ignition-gazebo-sensors-system"
            name="ignition::gazebo::systems::Sensors">
            <render_engine>ogre2</render_engine>
        </plugin>
    </gazebo>

    <!-- ============ 引入 arm macro (M2.3 已 macro 化) ============ -->
    <xacro:include
        filename="$(find s622_moveit_descriptions)/urdf/s622_moveit_descriptions.urdf.xacro" />
    <xacro:property name="instantiate" value="false" />
    <!-- ============ Left Arm: (0.35, 0, 0), yaw=π ============ -->
    <xacro:s622_arm prefix="left_" attach_world="false" />
    <joint name="left_mount_joint" type="fixed">
        <parent link="world" />
        <child link="left_base_link" />
        <origin xyz="0.35 0 0" rpy="0 0 ${M_PI}" />
    </joint>

    <!-- ============ Right Arm: (-0.35, 0, 0), yaw=0 ============ -->
    <xacro:s622_arm prefix="right_" attach_world="false" />
    <joint name="right_mount_joint" type="fixed">
        <parent link="world" />
        <child link="right_base_link" />
        <origin xyz="-0.35 0 0" rpy="0 0 0" />
    </joint>

    <!-- ============ Gripper 摩擦 (双臂各一份, 从 M2.1 前缀化) ============ -->
    <gazebo reference="left_finger1_joint">
        <mu1>500.0</mu1>
        <mu2>500.0</mu2>
        <kp>30000</kp>
        <kd>15</kd>
    </gazebo>
    <gazebo reference="left_finger2_joint">
        <mu1>500.0</mu1>
        <mu2>500.0</mu2>
        <kp>30000</kp>
        <kd>15</kd>
    </gazebo>
    <gazebo reference="right_finger1_joint">
        <mu1>500.0</mu1>
        <mu2>500.0</mu2>
        <kp>30000</kp>
        <kd>15</kd>
    </gazebo>
    <gazebo reference="right_finger2_joint">
        <mu1>500.0</mu1>
        <mu2>500.0</mu2>
        <kp>30000</kp>
        <kd>15</kd>
    </gazebo>

    <!-- ============ ros2_control x2 (左右各一份硬件接口) ============ -->
    <xacro:include filename="$(find gz_launch)/config/s622_gazebo_ros2_control.xacro" />

    <xacro:s622_moveit_descriptions_ros2_control
        name="GazeboSimSystem"
        initial_positions_file="$(find s622_moveit_config)/config/initial_positions.yaml"
        prefix="left_" />

    <xacro:s622_moveit_descriptions_ros2_control
        name="GazeboSimSystem"
        initial_positions_file="$(find s622_moveit_config)/config/initial_positions.yaml"
        prefix="right_" />

    <!-- ============ [M2] 全局俯视相机（默认关） ============
         world 相机（0,0.5,0.9 俯视）是旧视觉伺服用；M2 标定用腕部 wrist_camera，
         全局 eye-to-hand（M2.7）才需要它。默认关掉省一个 RGBD 渲染（Gazebo 卡因之一）。
         需要时：include_global_camera:=true
         [M2.7] 标定只用 RGB → enable_depth=false 减半渲染负载 -->
    <xacro:arg name="include_global_camera" default="false" />
    <xacro:include filename="$(find s622_moveit_descriptions)/urdf/camera/camera.xacro" />
    <xacro:if value="$(arg include_global_camera)">
        <xacro:camera_v0 parent="world"
                         use_camera_visual="$(arg include_camera_visual)">
            <origin xyz="0 0.5 0.9" rpy="0 ${58*M_PI/180} ${-M_PI/2}" />
        </xacro:camera_v0>
        <xacro:camera_gazebo_v0 enable_depth="false" />
    </xacro:if>

    <!-- ============ [M2.7] 全局 eye-to-hand 标定板（默认关） ============
         大号 ArUco（板 160mm / marker 130mm，DICT_5X5_250 id=1，纹理 aruco_id1.png），
         固定在指定臂的 grasp_frame 前方、板面朝 +x（全局相机在 (0,0.5,0.9) 俯视）。
         一次只出现一块（calibration_arm:=left|right|none），避免两块同 ID 板同帧。
         GT = 固定 joint 的 origin（可精确知道，但只用于最后 GT 验证，绝不喂 solver）。 -->
    <xacro:arg name="calibration_arm" default="none" />
    <xacro:property name="calib_arm" value="$(arg calibration_arm)" />
    <xacro:if value="${calib_arm == 'left'}">
        <link name="left_calibration_aruco">
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <box size="0.24 0.24 0.002" />
                </geometry>
            </visual>
        </link>
        <gazebo reference="left_calibration_aruco">
            <visual>
                <material>
                    <ambient>1 1 1 1</ambient>
                    <diffuse>1 1 1 1</diffuse>
                    <specular>0 0 0 1</specular>
                    <emissive>1 1 1 1</emissive>
                    <pbr>
                        <metal>
                            <albedo_map>model://aruco_marker_1/materials/textures/aruco_id1.png</albedo_map>
                            <emissive_map>model://aruco_marker_1/materials/textures/aruco_id1.png</emissive_map>
                            <metalness>0.0</metalness>
                            <roughness>1.0</roughness>
                        </metal>
                    </pbr>
                </material>
            </visual>
        </gazebo>
        <joint name="left_grasp_to_calibration_aruco" type="fixed">
            <parent link="left_grasp_frame" />
            <child link="left_calibration_aruco" />
            <!-- 板面 +x：纹理正面朝全局相机方向（grasp_frame +x 朝前） -->
            <origin xyz="0 0 0.13" rpy="1.5708 0 0" />
        </joint>
    </xacro:if>
    <xacro:if value="${calib_arm == 'right'}">
        <link name="right_calibration_aruco">
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <box size="0.24 0.24 0.002" />
                </geometry>
            </visual>
        </link>
        <gazebo reference="right_calibration_aruco">
            <visual>
                <material>
                    <ambient>1 1 1 1</ambient>
                    <diffuse>1 1 1 1</diffuse>
                    <specular>0 0 0 1</specular>
                    <emissive>1 1 1 1</emissive>
                    <pbr>
                        <metal>
                            <albedo_map>model://aruco_marker_1/materials/textures/aruco_id1.png</albedo_map>
                            <emissive_map>model://aruco_marker_1/materials/textures/aruco_id1.png</emissive_map>
                            <metalness>0.0</metalness>
                            <roughness>1.0</roughness>
                        </metal>
                    </pbr>
                </material>
            </visual>
        </gazebo>
        <joint name="right_grasp_to_calibration_aruco" type="fixed">
            <parent link="right_grasp_frame" />
            <child link="right_calibration_aruco" />
            <origin xyz="0 0 0.13" rpy="1.5708 0 0" />
        </joint>
    </xacro:if>

    <!-- ============ [M2 标定] 右腕相机 (eye-in-hand GT) ============
         2026-08-28：实验室仅 1 个腕部相机，装右臂 grasp_frame。
         GT = URDF 固定 right_grasp_frame → wrist_camera 变换（origin 照 robotarm
         tool0 安装值），标定后与求解结果比较（ground_truth_check_enabled=true）。
         [M2.7] 全局 eye-to-hand 标定期间用 include_wrist_camera:=false 关掉它，
         省一个 RGB 渲染 → 提升 Gazebo 帧率。 -->
    <xacro:arg name="include_wrist_camera" default="true" />
    <xacro:if value="$(arg include_wrist_camera)">
        <xacro:camera_v0 parent="right_grasp_frame" name="wrist_camera"
                         use_camera_visual="$(arg include_camera_visual)">
            <origin xyz="0 -0.05 -0.09" rpy="0 -1.57079632679 -1.57079632679" />
        </xacro:camera_v0>
        <!-- [M2 标定] wrist_camera 只渲染 RGB（enable_depth=false）：标定只用 RGB，
             关 depth 渲染减半 → 提升帧率（实测 1280×720 双传感器仅 2.3Hz → 稳定帧不足） -->
        <xacro:camera_gazebo_v0 name="wrist_camera" enable_depth="false" />
    </xacro:if>

</robot>