<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="s622">

    <xacro:property name="M_PI" value="3.1415926535897931" />

    <xacro:arg
        name="initial_positions_file"
        default="$(find s622_moveit_config)/config/initial_positions.yaml" />

    <xacro:include
        filename="$(find s622_moveit_descriptions)/urdf/s622_moveit_descriptions.urdf" />


    <gazebo>
        <plugin filename="gz_ros2_control-system"
            name="gz_ros2_control::GazeboSimROS2ControlPlugin">
            <parameters>$(find s622_moveit_config)/config/ros2_controllers.yaml</parameters>
        </plugin>

        <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher" />

        <plugin filename="gz-sim-pose-publisher-system"
            name="gz::sim::systems::PosePublisher">
            <publish_link_pose>true</publish_link_pose>
            <use_pose_vector_msg>true</use_pose_vector_msg>
            <publish_nested_model_pose>true</publish_nested_model_pose>
        </plugin>

        <plugin filename="ignition-gazebo-sensors-system"
            name="ignition::gazebo::systems::Sensors">
            <render_engine>ogre2</render_engine>
        </plugin>
    </gazebo>

    <!-- <gazebo reference="camera_link">
        <sensor name="rgbd_camera" type="rgbd_camera">
            <update_rate>30</update_rate>
            <topic>camera</topic>         
            <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
            <width>640</width>
            <height>480</height>
        </image>
        <clip>
            <near>0.05</near>
            <far>5.0</far>
        </clip>
    </camera>
            <always_on>1</always_on>
            <visualize>true</visualize>
        </sensor>
    </gazebo>
    -->
    
    <!-- 夹爪摩擦参数（防 Gazebo 抖动） -->
    <gazebo reference="finger1_joint">
        <mu1>500.0</mu1>
        <mu2>500.0</mu2>
        <kp>30000</kp>
        <kd>15</kd>
    </gazebo>
    <gazebo reference="finger2_joint">
        <mu1>500.0</mu1>
        <mu2>500.0</mu2>
        <kp>30000</kp>
        <kd>15</kd>
    </gazebo>

    <!-- ros2_control 标签实例化 -->
    <!-- <xacro:include filename="$(find
    s622_moveit_config)/config/s622_moveit_descriptions.ros2_control.xacro"/>
    <xacro:s622_moveit_descriptions_ros2_control
        name="GazeboSimSystem"
        initial_positions_file="$(arg initial_positions_file)"/> -->

    <xacro:include
        filename="$(find gz_launch)/config/s622_gazebo_ros2_control.xacro" />
    <xacro:s622_moveit_descriptions_ros2_control
        name="GazeboSimSystem"
        initial_positions_file="$(arg initial_positions_file)" />

    <!-- Camera -->
    <xacro:include
        filename="$(find s622_moveit_descriptions)/urdf/camera/camera.xacro" />

    <xacro:camera_v0
        parent="base_link">
        <!-- A: 右侧俯视工作区中心 (0.35, 0, 0.10) -->
        <origin xyz="0.35 0.5 0.9" rpy="0 ${58*M_PI/180} ${-M_PI/2}"/>
    </xacro:camera_v0>


    <xacro:camera_gazebo_v0 />
</robot>