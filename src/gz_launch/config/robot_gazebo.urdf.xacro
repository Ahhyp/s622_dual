<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="s622">

    <xacro:property name="M_PI" value="3.1415926535897931" />

    <!-- ============ 参数声明 ============ -->
    <xacro:arg name="robot_name" default="s622"/>
    <xacro:arg name="prefix" default=""/>
    <xacro:arg name="attach_world" default="true"/>
    <xacro:arg name="include_camera" default="true"/>
    <xacro:arg name="controllers_yaml" 
               default="$(find s622_moveit_config)/config/ros2_controllers.yaml"/>
    <xacro:arg name="initial_positions_file"
               default="$(find s622_moveit_config)/config/initial_positions.yaml" />

    <xacro:property name="prefix" value="$(arg prefix)"/>

    <!-- ============ 引入本体 URDF (xacro) ============ -->
    <xacro:include
        filename="$(find s622_moveit_descriptions)/urdf/s622_moveit_descriptions.urdf.xacro" />

    <!-- ============ Gazebo 全局插件 ============ -->
    <gazebo>
        <plugin filename="gz_ros2_control-system"
            name="gz_ros2_control::GazeboSimROS2ControlPlugin">
            <parameters>$(arg controllers_yaml)</parameters>
        </plugin>

        <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher" />

        <plugin filename="gz-sim-pose-publisher-system"
            name="gz::sim::systems::PosePublisher">
            <publish_link_pose>true</publish_link_pose>
            <use_pose_vector_msg>true</use_pose_vector_msg>
            <publish_nested_model_pose>true</publish_nested_model_pose>
        </plugin>

        <plugin filename="ignition-gazebo-sensors-system"
            name="ignition::gazebo::systems::Sensors">
            <render_engine>ogre2</render_engine>
        </plugin>
    </gazebo>

    <!-- ============ 夹爪摩擦 (前缀化) ============ -->
    <gazebo reference="${prefix}finger1_joint">
        <mu1>500.0</mu1>
        <mu2>500.0</mu2>
        <kp>30000</kp>
        <kd>15</kd>
    </gazebo>
    <gazebo reference="${prefix}finger2_joint">
        <mu1>500.0</mu1>
        <mu2>500.0</mu2>
        <kp>30000</kp>
        <kd>15</kd>
    </gazebo>

    <!-- ============ ros2_control 实例化 ============ -->
    <xacro:include
        filename="$(find gz_launch)/config/s622_gazebo_ros2_control.xacro" />
    <xacro:s622_moveit_descriptions_ros2_control
        name="GazeboSimSystem"
        initial_positions_file="$(arg initial_positions_file)"
        prefix="${prefix}" />

    <!-- ============ Camera (可选) ============ -->
    <xacro:if value="$(arg include_camera)">
        <xacro:include
            filename="$(find s622_moveit_descriptions)/urdf/camera/camera.xacro" />

        <xacro:camera_v0 parent="${prefix}base_link">
            <origin xyz="0.35 0.5 0.9" rpy="0 ${58*M_PI/180} ${-M_PI/2}"/>
        </xacro:camera_v0>

        <xacro:camera_gazebo_v0 />
    </xacro:if>

</robot>