<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <!-- 增加 prefix 参数, 默认为空以保持 M1.7 兼容 -->
    <xacro:macro name="s622_moveit_descriptions_ros2_control"
        params="name initial_positions_file prefix:='' arm_command_mode:='velocity' arm_position_gain:=1.0">

        <!-- [C2.9a] arm command interface selectable: velocity (JTC profile) or
             position (QP profile).  gz_ros2_control implements the position
             interface as a P-type servo: velocity ~= gain * (target - current). -->
        <xacro:property name="arm_cmd_iface"
            value="${'position' if arm_command_mode == 'position' else 'velocity'}" />
        <!-- gz_ros2_control position interface = P servo: v = gain*(q_des-q).
             gain 1.0 => tau = 1 s (very slow); a realistic joint servo is
             ~10-30 /s.  Configurable so the QP can be tuned. -->
        <xacro:property name="arm_pos_gain" value="${float(arm_position_gain)}" />
        
        <xacro:property name="initial_positions"
            value="${load_yaml(initial_positions_file)['initial_positions']}" />

        <ros2_control name="${prefix}${name}" type="system">
            <hardware>
                <plugin>gz_ros2_control/GazeboSimSystem</plugin>
                <!-- [C2.9] gz_ros2_control reads this from hardware_parameters
                     (a per-JOINT <param> is silently ignored and the default
                     0.1 is used => tau = 10 s!). -->
                <xacro:if value="${arm_command_mode == 'position'}">
                    <param name="position_proportional_gain">${arm_pos_gain}</param>
                </xacro:if>
            </hardware>
            
            <!-- 6 个关节全部前缀化,同时 initial_positions 用无前缀 key 索引 -->
            <joint name="${prefix}j1">
                <command_interface name="${arm_cmd_iface}" />
                <state_interface name="position">
                    <param name="initial_value">${initial_positions['j1']}</param>
                </state_interface>
                <state_interface name="velocity" />
            </joint>

            <joint name="${prefix}j2">
                <command_interface name="${arm_cmd_iface}" />
                <state_interface name="position">
                    <param name="initial_value">${initial_positions['j2']}</param>
                </state_interface>
                <state_interface name="velocity" />
            </joint>

            <joint name="${prefix}j3">
                <command_interface name="${arm_cmd_iface}" />
                <state_interface name="position">
                    <param name="initial_value">${initial_positions['j3']}</param>
                </state_interface>
                <state_interface name="velocity" />
            </joint>

            <joint name="${prefix}j4">
                <command_interface name="${arm_cmd_iface}" />
                <state_interface name="position">
                    <param name="initial_value">${initial_positions['j4']}</param>
                </state_interface>
                <state_interface name="velocity" />
            </joint>

            <joint name="${prefix}j5">
                <command_interface name="${arm_cmd_iface}" />
                <state_interface name="position">
                    <param name="initial_value">${initial_positions['j5']}</param>
                </state_interface>
                <state_interface name="velocity" />
            </joint>

            <joint name="${prefix}j6">
                <command_interface name="${arm_cmd_iface}" />
                <state_interface name="position">
                    <param name="initial_value">${initial_positions['j6']}</param>
                </state_interface>
                <state_interface name="velocity" />
            </joint>

            <joint name="${prefix}finger1_joint">
                <command_interface name="position" />
                <state_interface name="position">
                    <param name="initial_value">${initial_positions['finger1_joint']}</param>
                </state_interface>
                <!-- 2026-08-26：补 velocity state interface（对齐手臂关节）。
                     缺失时 JSB 发布 finger velocity=NaN，且 gz_ros2_control read()
                     无判空读 JointVelocity 组件 → write() POSITION 分支 target_vel=NaN
                     → gazebo [Err] Invalid joint velocity value [nan] commanded -->
                <state_interface name="velocity" />
            </joint>
            
            <joint name="${prefix}finger2_joint">
                <command_interface name="position" />
                <state_interface name="position">
                    <param name="initial_value">${initial_positions['finger2_joint']}</param>
                </state_interface>
                <state_interface name="velocity" />
            </joint>

        </ros2_control>
    </xacro:macro>
</robot>