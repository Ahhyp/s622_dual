  <!-- 夹爪摩擦参数（防 Gazebo 抖动） -->
  <gazebo reference="finger1_joint">
    <mu1>500.0</mu1>
    <mu2>500.0</mu2>
    <kp>30000</kp>
    <kd>15</kd>
  </gazebo>
  <gazebo reference="finger2_joint">
    <mu1>500.0</mu1>
    <mu2>500.0</mu2>
    <kp>30000</kp>
    <kd>15</kd>
  </gazebo>
  <!-- ros2_control 标签实例化 -->
  <!-- <xacro:include filename="$(find
    s622_moveit_config)/config/s622_moveit_descriptions.ros2_control.xacro"/>
    <xacro:s622_moveit_descriptions_ros2_control
        name="GazeboSimSystem"
        initial_positions_file="$(arg initial_positions_file)"/> -->
  <ros2_control name="GazeboSimSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <joint name="j1">
      <command_interface name="velocity"/>
      <state_interface name="position">
        <param name="initial_value">0.5</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="j2">
      <command_interface name="velocity"/>
      <state_interface name="position">
        <param name="initial_value">-1.05</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="j3">
      <command_interface name="velocity"/>
      <state_interface name="position">
        <param name="initial_value">1.05</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="j4">
      <command_interface name="velocity"/>
      <state_interface name="position">
        <param name="initial_value">-1.05</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="j5">
      <command_interface name="velocity"/>
      <state_interface name="position">
        <param name="initial_value">-0.8</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="j6">
      <command_interface name="velocity"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="finger1_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0</param>
      </state_interface>
      <!-- <state_interface name="velocity"/> -->
    </joint>
    <joint name="finger2_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0</param>
      </state_interface>
      <!-- <state_interface name="velocity"/> -->
    </joint>
  </ros2_control>
  <material name="aluminum">
    <color rgba="0.5 0.5 0.5 1"/>
  </material>
  <material name="plastic">
    <color rgba="0.1 0.1 0.1 1"/>
  </material>
